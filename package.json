{
  "name": "weekly-research-slides",
  "version": "0.8.0",
  "description": "Agent skill for turning weekly changes in research methods, evidence, claims, and diagnostics into a template-driven LaTeX Beamer PDF (default) or editable PowerPoint research update, with native TikZ, Draw.io and Manim scientific figures.",
  "license": "MIT",
  "type": "commonjs",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhlamauto/weekly-research-slides.git"
  },
  "homepage": "https://github.com/thanhlamauto/weekly-research-slides#readme",
  "bugs": {
    "url": "https://github.com/thanhlamauto/weekly-research-slides/issues"
  },
  "keywords": [
    "agent-skill",
    "research",
    "beamer",
    "latex",
    "tikz",
    "pdf",
    "powerpoint",
    "pptx",
    "presentation",
    "scientific-presentation",
    "lab-meeting",
    "research-workflow",
    "ai-agent"
  ],
  "bin": {
    "wrs": "src/cli.js"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "references",
    "schemas",
    "scripts",
    "src",
    "templates"
  ],
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "demo": "node src/cli.js demo",
    "build": "node src/cli.js build",
    "build:pdf": "node src/cli.js build --input examples/diagnostic-week/slide_spec.yaml --output examples/diagnostic-week/output/demo-weekly-research-slides.pdf --render-pages",
    "build:pptx": "node src/cli.js build --input examples/diagnostic-week/slide_spec.yaml --output examples/diagnostic-week/output/demo-weekly-research-slides.pptx --renderer pptx",
    "qa": "node src/cli.js qa",
    "render": "node src/cli.js render",
    "inspect": "node src/cli.js inspect",
    "edit": "node src/cli.js edit",
    "plan": "node src/cli.js plan",
    "diff": "node src/cli.js diff",
    "validate": "node src/cli.js validate",
    "scene": "node src/cli.js scene",
    "route": "node src/cli.js route",
    "tikz": "node src/cli.js tikz",
    "tikz:qa": "node src/cli.js tikz:qa",
    "demo:figures": "node src/cli.js demo:figures",
    "critique": "node src/cli.js critique",
    "critique:demo": "node src/cli.js critique --input examples/diagnostic-week/draft_verbose_slide_spec.yaml --output examples/diagnostic-week/revised_verbose_slide_spec.yaml --deck examples/diagnostic-week/output/demo-weekly-research-slides-revised.pptx --qa-dir examples/diagnostic-week/critique",
    "test": "node --test tests/*.test.js",
    "assets": "node scripts/make_docs_assets.js",
    "video:doctor": "python3 skills/research-method-video/scripts/video_doctor.py",
    "video:render": "python3 skills/research-method-video/scripts/render_scene.py --project examples/lesa --quality draft --concat examples/lesa/renders/draft/lesa-method-explainer.mp4",
    "video:render:final": "python3 skills/research-method-video/scripts/render_scene.py --project examples/lesa --quality final --concat examples/lesa/renders/final/lesa-method-explainer.mp4",
    "video:qa": "python3 skills/research-method-video/scripts/qa_video.py --input examples/lesa/renders/draft/lesa-method-explainer.mp4 --output examples/lesa/qa --count 21",
    "video:lint": "python3 skills/research-method-video/scripts/lint_scenes.py --project examples/lesa",
    "video:render:narrated": "python3 skills/research-method-video/scripts/render_scene.py --project examples/lesa --quality final --timing transcript --concat examples/lesa/renders/final/lesa-method-explainer.mp4",
    "transcript:build": "python3 skills/research-method-video/scripts/build_transcript.py --project examples/lesa --audience adjacent-researcher",
    "transcript:qa": "python3 skills/research-method-video/scripts/qa_transcript.py --project examples/lesa",
    "transcript:subtitles": "python3 skills/research-method-video/scripts/export_subtitles.py --project examples/lesa",
    "transcript:notes": "python3 skills/research-method-video/scripts/export_speaker_notes.py --project examples/lesa",
    "transcript:tts": "python3 skills/research-method-video/scripts/tts_narration.py --project examples/lesa",
    "transcript:align": "python3 skills/research-method-video/scripts/align_recording.py --project examples/lesa",
    "video:narrate": "python3 skills/research-method-video/scripts/mux_narration.py --project examples/lesa --quality final",
    "voice:qa": "python3 skills/research-method-video/scripts/qa_voice.py --project examples/lesa",
    "voice:ab": "python3 skills/research-method-video/scripts/voice_ab.py --project examples/lesa --gemini dry-run",
    "figure:doctor": "python3 skills/research-method-figure/scripts/figure_doctor.py",
    "figure:build": "python3 skills/research-method-figure/scripts/build_figure.py --method examples/lesa/method_model.yaml --style topconf-clean --output examples/lesa/figure/lesa_overview.drawio",
    "figure:compare": "python3 skills/research-method-figure/scripts/compare_methods.py --left examples/figure-comparison/competitor_method.yaml --right examples/figure-comparison/ours_method.yaml --left-label \"Static Top-K\" --right-label \"BAR (ours)\" --style topconf-clean --output examples/figure-comparison/output/comparison.drawio",
    "figure:delta": "python3 skills/research-method-figure/scripts/method_delta.py --prev examples/figure-comparison/ours_method_v3.yaml --curr examples/figure-comparison/ours_method.yaml --style topconf-clean --output examples/figure-comparison/output/method_delta.drawio",
    "figure:extract": "python3 skills/research-method-figure/scripts/extract_style.py --reference examples/figure-style-transfer/reference.svg --name paper-style",
    "figure:qa": "python3 skills/research-method-figure/scripts/qa_figure.py --spec examples/figure-comparison/output/comparison_spec.yaml --output-dir examples/figure-comparison/qa",
    "figure:pptx": "node skills/research-method-figure/scripts/figure_to_pptx.js --input examples/figure-comparison/output/comparison.ir.json --output examples/figure-comparison/output/comparison.pptx",
    "check": "npm run test && npm run demo"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.1",
    "js-yaml": "4.1.0",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.1"
  }
}
