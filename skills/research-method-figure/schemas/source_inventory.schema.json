{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source_inventory.schema.json",
  "title": "Source Inventory",
  "description": "Explicit classification of every input. A STYLE_SOURCE controls visual grammar only and must never inject scientific content, labels, claims, data or logos.",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "roles"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["CONTENT_SOURCE", "STRUCTURE_SOURCE", "STYLE_SOURCE", "LAYOUT_SOURCE", "ASSET_SOURCE"]
            }
          },
          "redistributable": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
