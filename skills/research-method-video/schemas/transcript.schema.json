{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "transcript.schema.json",
  "title": "Video Transcript",
  "description": "First-class narration for a method explainer. The script is authored before animation; timing is estimated deterministically for silent mode or supplied by TTS/forced alignment. Stable scene and beat ids link narration to visual beats.",
  "type": "object",
  "required": ["video", "audience", "scenes"],
  "additionalProperties": false,
  "properties": {
    "video": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "title": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "audience": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["expert", "adjacent-researcher", "general-technical"] },
        "target_wpm": { "type": "number", "minimum": 60 }
      }
    },
    "mode": { "type": "string", "enum": ["silent", "tts", "recorded"] },
    "narration": {
      "type": "object",
      "description": "Project-level narration configuration. The transcript stays provider-independent; the delivery plan and provider prompt are derived from it.",
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "enum": ["gemini", "macos-say", "say", "pyttsx3", "recorded", "silent", "auto"] },
        "model": { "type": "string" },
        "voice": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": false,
              "properties": { "name": { "type": "string" } } }
          ]
        },
        "profile": { "type": "string" },
        "pacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_wpm": { "type": "number", "minimum": 60 },
            "min_concept_dwell_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "chunking": {
          "type": "object",
          "description": "Semantic chunk size bounds for TTS requests. Raise the minimum to merge beats into fewer, longer requests (useful for per-day provider quotas).",
          "additionalProperties": false,
          "properties": {
            "min_seconds": { "type": "number", "minimum": 1 },
            "max_seconds": { "type": "number", "minimum": 2 }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "type": "string" },
            "voice": { "type": "string" }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "description": "Scene timing hints: which beats the Manim scenes wait on (hooks) and measured animation-only seconds per scene. Used to distribute actual audio duration into waits instead of a frozen final frame.",
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "animation_seconds": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "duration_seconds": { "type": "number", "description": "Computed total duration." },
    "word_count": { "type": "integer" },
    "target_wpm": { "type": "number" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "takeaway": { "type": "string" },
          "dwell_seconds": { "type": "number", "minimum": 0 },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "duration_seconds": { "type": "number" },
          "tail_dwell": { "type": "number" },
          "audio_duration_seconds": { "type": "number", "description": "Actual synthesized narration duration when available." },
          "word_count": { "type": "integer" },
          "narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["beat_id", "text"],
              "additionalProperties": false,
              "properties": {
                "beat_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                "text": { "type": "string", "minLength": 1 },
                "visual_cue": { "type": "string", "description": "scene_spec beat id or action this narration accompanies." },
                "emphasis": { "type": "array", "items": { "type": "string" } },
                "kind": {
                  "type": "string",
                  "enum": ["normal", "introduction", "equation", "comparison", "aha", "conclusion"],
                  "description": "Drives extra comprehension dwell."
                },
                "dwell_seconds": { "type": "number", "minimum": 0 },
                "start": { "type": "number" },
                "end": { "type": "number" },
                "end_with_dwell": { "type": "number" },
                "speaking_seconds": { "type": "number" },
                "word_count": { "type": "integer" },
                "words": { "type": "array", "items": { "type": "string" } },
                "dwell_source": { "type": "string", "enum": ["kind", "audio-surplus", "audio-budget", "authored"] },
                "audio": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "chunk_id": { "type": "string" },
                    "duration": { "type": "number" }
                  }
                },
                "delivery": {
                  "type": "object",
                  "description": "Optional prosody metadata. All fields are optional; strong defaults come from the intent and the voice profile.",
                  "additionalProperties": false,
                  "properties": {
                    "intent": { "type": "string" },
                    "tone": { "type": "string" },
                    "pace": { "type": "string" },
                    "energy": { "type": "string" },
                    "pause_before_ms": { "type": "integer", "minimum": 0, "maximum": 1200 },
                    "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 1200 },
                    "emphasis": { "type": "array", "items": { "type": "string" } },
                    "direction": { "type": "string" }
                  }
                },
                "cue": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "phrase": { "type": "string" },
                    "animation": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
