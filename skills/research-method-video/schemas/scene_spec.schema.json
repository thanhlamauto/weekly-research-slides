{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene_spec.schema.json",
  "title": "Video Scene Spec",
  "description": "The semantic bridge between scientific understanding and Manim implementation. Scenes carry actors, explanation beats, start/end visual states and speaker intent; Manim source implements the geometry.",
  "type": "object",
  "required": ["video", "scenes"],
  "additionalProperties": false,
  "properties": {
    "video": {
      "type": "object",
      "required": ["title", "method"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "method": { "type": "string" },
        "mode": { "type": "string", "enum": ["competitor", "ours", "baseline"] },
        "method_model": { "type": "string" },
        "description": { "type": "string" },
        "audience": {
          "type": "string",
          "enum": ["expert", "adjacent-researcher", "general-technical"],
          "description": "Controls how much background is introduced and how long key states dwell."
        },
        "target_duration_seconds": { "type": "number", "minimum": 10 },
        "canvas": { "type": "string", "enum": ["light", "dark"] },
        "theme": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "beats"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "question": { "type": "string" },
          "mode": { "type": "string", "enum": ["competitor", "ours", "baseline"] },
          "manim_class": { "type": "string", "description": "Manim Scene class name registered in src/main.py." },
          "method_refs": { "type": "array", "items": { "type": "string" } },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
                "type": {
                  "type": "string",
                  "enum": ["feature", "module", "learned", "cache", "operator", "timeline", "panel", "dot", "vector", "stage", "text", "expert"]
                },
                "label": { "type": "string" },
                "persistent": { "type": "boolean" },
                "role": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "start_state": { "type": "string" },
          "end_state": { "type": "string" },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "pattern"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "pattern": {
                  "type": "string",
                  "enum": ["ESTABLISH", "TRACE", "BUILD", "MORPH", "FOCUS", "COMPARE", "TRAJECTORY", "STAGE-SPLIT", "ACCUMULATION", "CORRECTION", "REPLAY", "REVEAL", "ZOOM", "RECAP"]
                },
                "action": { "type": "string" },
                "speaker_note": { "type": "string" },
                "narration_note": { "type": "string" },
                "duration_seconds": { "type": "number", "minimum": 0 }
              }
            }
          },
          "transition_to": { "type": "string" },
          "keyframe": {
            "type": "object",
            "description": "A representative still for the PPT bridge: a fraction (0-1) of this scene's duration.",
            "required": ["fraction", "purpose"],
            "additionalProperties": false,
            "properties": {
              "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "purpose": { "type": "string" }
            }
          },
          "narration_note": { "type": "string" },
          "speaker_note": { "type": "string" }
        }
      }
    }
  }
}
