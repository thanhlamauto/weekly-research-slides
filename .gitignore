node_modules/
npm-debug.log*
.DS_Store
*.tgz

# Local scratch / build outputs at the repo root
/out/
/qa_report.json
/scene.json

# Generated example previews (gallery lives in docs/images/ instead)
examples/**/output/preview/
examples/**/output/rendered/

# research-method-video: keep the concatenated explainer, ignore Manim scratch
# and the per-scene intermediates.
.venv-manim/
__pycache__/
*.pyc
examples/lesa/renders/_media/
examples/lesa/renders/draft/lesa_0*.mp4
examples/lesa/renders/final/lesa_0*.mp4
examples/lesa/renders/**/_concat.txt
examples/lesa/renders/**/*_concat.txt
examples/lesa/qa/frames/
examples/lesa/transcript/audio/

# voice work: never commit credentials; keep raw A/B audio local (compressed
# samples and comparison.md are committed instead)
.env
.env.*
*.key
*credentials*.json
examples/**/qa/voice/ab/**/*.wav
examples/**/qa/voice/ab/**/*.aiff
examples/**/qa/voice/ab/**/cache/
examples/**/qa/voice/ab/**/chunks/
examples/lesa/renders/_narrated_work/

# critique loop: keep contact sheets + reports, drop per-slide intermediates
examples/diagnostic-week/critique/renders/slide-*.png
examples/diagnostic-week/critique/renders/slide-*.svg
examples/diagnostic-week/critique/before/slide-*.png
examples/diagnostic-week/critique/before/slide-*.svg

# Beamer: keep generated LaTeX sources + manifest, drop latex aux/state files
examples/**/output/beamer-build/*.aux
examples/**/output/beamer-build/*.log
examples/**/output/beamer-build/*.fls
examples/**/output/beamer-build/*.fdb_latexmk
examples/**/output/beamer-build/*.out
examples/**/output/beamer-build/*.synctex.gz
examples/**/output/beamer-build/*.nav
examples/**/output/beamer-build/*.snm
examples/**/output/beamer-build/*.toc
examples/**/output/beamer-build/*.vrb
examples/**/output/beamer-build/*.pdf
# keep the Beamer contact sheet, drop the per-page intermediates (docs/images has the gallery copies)
examples/**/output/beamer-pages/slide-*.png

# diagram-backends demo: keep sources, PDFs, contact sheet and reports; drop
# latex aux, per-page intermediates and standalone render scratch
examples/**/output/pages/slide-*.png
examples/**/output/figures/**/*.aux
examples/**/output/figures/**/*.log
examples/**/output/figures/**/*.fls
examples/**/output/figures/**/*.fdb_latexmk
examples/**/output/figures/**/*.out
examples/**/output/figures/**/*.synctex.gz
examples/**/qa/**/render/
